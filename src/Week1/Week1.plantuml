@startuml

title __WEEK1's Class Diagram__\n

  namespace Week1 {
    class Week1.BankAccount {
        - accountID : int
        - balance : double
        - firstName : String
        - lastName : String
        + BankAccount()
        + accountSummary()
        + deposit()
        + getAccountID()
        + getBalance()
        + getFirstName()
        + getLastName()
        + setAccountID()
        + setFirstName()
        + setLastName()
        + withdrawal()
    }
  }
  

  namespace Week1 {
    class Week1.CheckingAccount {
        - interestRate : double
        + CheckingAccount()
        + displayAccount()
        + processWithdrawal()
    }
  }
  

  namespace Week1 {
    class Week1.TestBankAccount {
        {static} + main()
    }
  }
  

  Week1.CheckingAccount -up-|> Week1.BankAccount


right footer


